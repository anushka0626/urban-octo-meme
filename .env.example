# Copy to .env for local dev; add the same three to Vercel → Project → Settings → Environment Variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Guestbook storage. On Vercel: Storage → Create → Upstash (Redis) and connect it to the
# project; it adds KV_REST_API_URL / KV_REST_API_TOKEN automatically. Copy them here for local use.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any long random string (e.g. `openssl rand -hex 24`). Lets `npm run guestbook` approve/delete notes.
GUESTBOOK_ADMIN_TOKEN=
# Where `npm run guestbook` talks to (your live site, or http://localhost:4321 while developing)
SITE_URL=https://anushkaaaa.vercel.app
