---
import Window from '../Window.astro';
import { site } from '../../data/site';
const { open } = Astro.props;
const { playlist } = site.spotify;
const playlistId = playlist.url.split('/playlist/')[1]?.split('?')[0] ?? '';
---

<Window id="music" title="Media Player" icon="music" url="/music" open={open} w={560} h={600}>
  <div class="player" data-playlist={playlistId}>
    <div class="player-now">
      <div class="player-art">
        <img id="mp-fallback" src="/pixels/cassette.svg" alt="" width="150" height="150" />
        <canvas id="mp-canvas" width="20" height="20" hidden></canvas>
        <img id="mp-real" alt="" width="150" height="150" hidden />
      </div>
      <div class="player-meta">
        <p class="eyebrow" id="mp-label">not playing right now · on repeat lately</p>
        <h1 id="mp-title">{playlist.name}</h1>
        <p class="muted" id="mp-artist">a playlist I love</p>
        <div class="player-bar" id="mp-bar" hidden><span id="mp-progress"></span></div>
        <div class="btn-row" style="margin:12px 0 0">
          <a class="btn primary" id="mp-link" href={playlist.url} target="_blank" rel="noopener">Open in Spotify ↗</a>
        </div>
      </div>
    </div>
    <div class="player-embed" id="mp-embed">
      <noscript><a href={playlist.url}>Listen to “{playlist.name}” on Spotify</a></noscript>
    </div>
    <p class="player-note muted">
      Live from my Spotify. When I'm not listening to anything, you get a playlist I love.
    </p>
  </div>
</Window>

<style is:global>
  .player {
    min-height: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--font-body);
    background:
      radial-gradient(circle at 90% 0%, rgba(255, 158, 207, 0.25), transparent 45%),
      linear-gradient(#f7f4ff, #eef6ff);
  }
  .player-now {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .player-art {
    flex: none;
    width: 162px;
    height: 162px;
    padding: 6px;
    border-radius: 10px;
    background: #1f2433;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.4) inset,
      0 8px 20px rgba(30, 30, 80, 0.3);
    position: relative;
  }
  .player-art img,
  .player-art canvas {
    width: 150px;
    height: 150px;
    display: block;
    border-radius: 4px;
    image-rendering: pixelated;
  }
  .player-art [hidden] {
    display: none;
  }
  /* hover the pixel cover to "unpixelate" it */
  .player-art.has-art:hover canvas {
    display: none;
  }
  .player-art.has-art:hover #mp-real {
    display: block;
    image-rendering: auto;
  }
  .player-meta {
    min-width: 0;
  }
  .player-meta h1 {
    margin: 0 0 2px;
    font-size: 22px;
    line-height: 1.25;
  }
  .player-meta p {
    margin: 0;
  }
  .player-bar {
    height: 6px;
    margin-top: 12px;
    border-radius: 3px;
    background: #dcd6f5;
    overflow: hidden;
  }
  .player-bar[hidden] {
    display: none;
  }
  .player-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--pink), #7a5fe0);
    transition: width 1s linear;
  }
  .player-embed {
    flex: 1;
    min-height: 152px;
  }
  .player-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 152px;
    border: 0;
    border-radius: 12px;
  }
  .player-note {
    margin: 0;
    font-size: 12.5px;
  }
  @media (max-width: 768px) {
    .player-now {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
